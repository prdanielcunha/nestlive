{
  "name": "@millionsnest/nestlive-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/nestlive-node.cjs",
    "start": "node dist/nestlive-node.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package:sea": "npm run build && node scripts/build-sea.mjs"
  },
  "dependencies": {
    "@millionsnest/nestlive-domain": "0.1.0",
    "@millionsnest/nestlive-adapter-audio-sim": "0.1.0",
    "@millionsnest/nestlive-adapter-x32": "0.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10",
    "postject": "^1.0.0-alpha.6"
  }
}
