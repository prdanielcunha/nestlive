{
  "name": "@millionsnest/nestlive-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/nestlive-service.cjs",
    "start": "node dist/nestlive-service.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package:sea": "npm run build && node scripts/build-sea.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.12",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10",
    "postject": "^1.0.0-alpha.6"
  }
}
